# ============================================================
# AILPA – AI Incident Learning & Prevention Agent
# Environment Configuration Template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- AI MODE ---
# "offline" uses built-in simulation (no API key needed)
# "online"  calls a real LLM API
VITE_AI_MODE=offline

# --- AI PROVIDER (used when VITE_AI_MODE=online) ---
# Supported: "openai" | "anthropic" | "gemini"
VITE_AI_PROVIDER=openai

# --- MODEL ---
# OpenAI:    gpt-4o | gpt-4-turbo | gpt-3.5-turbo
# Anthropic: claude-3-5-sonnet-20241022 | claude-3-haiku-20240307
# Gemini:    gemini-1.5-pro | gemini-1.5-flash
VITE_AI_MODEL=gpt-4o

# --- API KEYS (only required when VITE_AI_MODE=online) ---
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=
VITE_GEMINI_API_KEY=

# --- OPTIONAL: Custom API endpoint (proxy / self-hosted) ---
VITE_AI_ENDPOINT=

# --- APP ---
VITE_APP_NAME=AILPA
VITE_APP_VERSION=1.0.0
